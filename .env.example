# Datenbank (setzt die Neon-Integration auf Vercel automatisch als DATABASE_URL / DATABASE_URL_UNPOOLED)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/partnernetz

# Öffentliche Adresse der Plattform (für Links in E-Mails, Sitemap, Siegel)
NEXT_PUBLIC_SITE_URL=https://partner.hyloft.de

# Geheimer Schlüssel für den IP-Hash im Spamschutz (beliebige lange Zufallszeichenkette)
SESSION_SECRET=

# Einmal-Schlüssel für die Ersteinrichtung des Admin-Passworts: /setup?token=…
SETUP_TOKEN=

# Admin-Konten, die bei jedem Build angelegt werden (Komma-getrennt)
ADMIN_EMAILS=simon@reinkober.com

# E-Mail-Versand über Resend (ohne Schlüssel werden Mails nur im Admin protokolliert)
RESEND_API_KEY=
MAIL_ABSENDER=Hyloft Partnernetz <info@partner.hyloft.de>
MAIL_ANTWORT_AN=info@hyloft.de
HYLOFT_INTERN_EMAIL=simon@reinkober.com,info@hyloft.de
